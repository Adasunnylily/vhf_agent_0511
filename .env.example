VHF_DATA_DIR=data
VHF_DEFAULT_CHANNEL_ID=vhf_demo_01
VHF_VAD_FRAME_MS=30
VHF_VAD_SILENCE_MS=900
VHF_VAD_MIN_SPEECH_MS=600

# ASR provider: dashscope_paraformer | qwen_api | funasr
VHF_ASR_PROVIDER=dashscope_paraformer
VHF_ASR_MODEL=paraformer-v2
VHF_ASR_DIARIZATION_ENABLED=1
VHF_ASR_SPEAKER_COUNT=2
# DashScope 热词：先运行 scripts/sync_dashscope_vocabulary.py 创建词表
# target_model 必须与 Recognition 使用的模型一致（默认 paraformer-realtime-v2）
# VHF_ASR_VOCABULARY_ID=
# VHF_ASR_VOCABULARY_TARGET_MODEL=paraformer-realtime-v2
# VHF_ASR_VOCABULARY_PREFIX=vhfnbzh
# VHF_ASR_VOCABULARY_WEIGHT=4
# VHF_ASR_VOCABULARY_CACHE=data/hotwords/dashscope_vocabulary_id.txt
VHF_ASR_HOTWORDS_PATH=data/hotwords/nbzh_hotwords.txt
DASHSCOPE_API_KEY=

# 火山/豆包 ASR 可选：控制台创建热词表后填写
# VOLCENGINE_ASR_BOOSTING_TABLE_ID=
# 未设置时默认见 app/services/asr_prompts.py
# VHF_ASR_EVAL_PROMPT=这是一段VHF海事通信音频...
# 主链路 Qwen 未单独设置 VHF_QWEN_ASR_PROMPT 时也会使用 VHF_ASR_EVAL_PROMPT

# Legacy Qwen chat-audio ASR
# VHF_ASR_PROVIDER=qwen_api
# VHF_ASR_MODEL=qwen3-asr-flash

# 智能分类/处置：rules | llm | hybrid
# llm/hybrid 会先调用 OpenAI 兼容大模型输出 JSON，失败时回退到关键词规则。
VHF_DECISION_MODE=llm
VHF_DECISION_MODEL=qwen-max
VHF_DECISION_API_KEY_ENV=DASHSCOPE_API_KEY
VHF_DECISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VHF_DECISION_TIMEOUT_S=30
# VHF_DECISION_FAIL_FAST=0
# DeepSeek 示例：
# VHF_DECISION_MODEL=deepseek-chat
# VHF_DECISION_API_KEY_ENV=DEEPSEEK_API_KEY
# VHF_DECISION_BASE_URL=https://api.deepseek.com
# 豆包/火山方舟示例：按控制台模型名与 OpenAI 兼容地址填写
# VHF_DECISION_MODEL=Doubao-Seed-2.0-lite
# VHF_DECISION_API_KEY_ENV=ARK_API_KEY
# VHF_DECISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

VHF_ASR_VAD_MODEL=fsmn-vad
VHF_ASR_PUNC_MODEL=
VHF_ASR_DEVICE=cuda:0
VHF_ASR_HUB=ms
VHF_ASR_BATCH_SIZE_S=30
VHF_ASR_MODEL_REVISION=
VHF_ASR_LANGUAGE=auto
VHF_ASR_USE_ITN=1
VHF_ASR_VAD_MAX_SINGLE_SEGMENT_TIME=30000
VHF_FORCE_FULL_FILE_TRANSCRIBE=0
VHF_STREAM_SIMULATION_SPEED=8.0
VHF_STREAMING_MODEL=paraformer-zh-streaming
VHF_STREAMING_CHUNK_SIZE=0,10,5
VHF_STREAMING_ENCODER_CHUNK_LOOK_BACK=4
VHF_STREAMING_DECODER_CHUNK_LOOK_BACK=1
VHF_DENOISE_FILTER_CHAIN=highpass=f=120,lowpass=f=3800,afftdn=nf=-25
